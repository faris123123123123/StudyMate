PORT=4000
# Pisahkan dengan koma. Sudah termasuk origin Tauri dan Capacitor.
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost,capacitor://localhost,https://localhost,http://localhost
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# HANYA di server. Jangan pernah ditaruh di frontend (SRS 5.2).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=studymate-storage
MAX_UPLOAD_MB=25
USER_QUOTA_MB=500
# Buat dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
ENABLE_WORKER=true
